<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
  <meta name="theme-color" content="#F7F7F5" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="축의대" />
  <meta name="description" content="결혼식 축의금 접수를 실수 없이 기록하고 엑셀로 바로 정리하는 오프라인 축의금 장부 앱" />
  <title>축의대 - 결혼식 축의금 접수 장부</title>

  <!-- Dynamic Inline PWA Icons & Web App Manifest (100% self-contained single file) -->
  <link id="appFavicon" rel="icon" type="image/svg+xml" href="" />
  <link id="appleTouchIcon" rel="apple-touch-icon" href="" />
  <link id="webManifest" rel="manifest" href="" />

  <!-- Pretendard Korean Typography -->
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- SheetJS for Multi-Sheet Excel (.xlsx) Export -->
  <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>

  <style>
    :root {
      --bg-page: #F7F7F5;
      --bg-card: #FFFFFF;
      --text-primary: #191F28;
      --text-secondary: #4E5968;
      --text-muted: #8B95A1;
      --border-subtle: #E8E6E1;
      --accent-primary: #8B263E;
      --accent-hover: #731E32;
      --accent-soft: #FDF2F4;
      --accent-border: #F3D1D8;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      margin: 0;
      padding: 0;
      background-color: #EFECE6;
      color: var(--text-primary);
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, 'Helvetica Neue', 'Apple SD Gothic Neo', 'Noto Sans KR', 'Malgun Gothic', sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      touch-action: manipulation;
    }

    /* Centered Mobile-First App Shell */
    .app-shell {
      max-width: 480px;
      min-height: 100dvh;
      margin: 0 auto;
      background-color: var(--bg-page);
      position: relative;
      display: flex;
      flex-direction: column;
      box-shadow: 0 0 30px rgba(25, 31, 40, 0.06);
    }

    /* Minimum 48px Touch Targets & Crisp Tactile Press */
    button, a.btn-touch, label.touch-label, input[type="checkbox"] {
      touch-action: manipulation;
    }

    .btn-primary {
      background-color: var(--accent-primary);
      color: #FFFFFF;
      transition: background-color 0.15s ease, transform 0.08s ease, opacity 0.15s ease;
    }
    .btn-primary:hover:not(:disabled) {
      background-color: var(--accent-hover);
    }
    .btn-primary:active:not(:disabled) {
      transform: scale(0.985);
    }
    .btn-primary:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .btn-secondary {
      background-color: #FFFFFF;
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
      transition: background-color 0.15s ease, transform 0.08s ease;
    }
    .btn-secondary:hover:not(:disabled) {
      background-color: #F2F0EC;
    }
    .btn-secondary:active:not(:disabled) {
      transform: scale(0.985);
    }

    .card-surface {
      background-color: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      box-shadow: 0 1px 3px rgba(25, 31, 40, 0.03);
    }

    /* Custom Scrollbar Hiding for Horizontal Filter Pills */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Safe-area bottom padding for mobile browsers */
    .pb-safe {
      padding-bottom: calc(12px + env(safe-area-inset-bottom));
    }

    /* Smooth Modal & Toast Animations */
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.18s ease-out forwards;
    }
    .animate-slide-up {
      animation: slideUp 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Remove number input spinners */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type="number"] {
      -moz-appearance: textfield;
    }
  </style>
</head>
<body>
  <div class="app-shell" id="appRoot">
    <!-- Global Toast Notification Banner -->
    <div id="toastContainer" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[92%] max-w-[448px] pointer-events-none flex flex-col gap-2"></div>

    <!-- =====================================================================
         SCREEN 1: HOME SCREEN ('축의대')
         ===================================================================== -->
    <main id="homeScreen" class="flex-1 flex flex-col px-5 pt-7 pb-8">
      <!-- Top Header -->
      <header class="mb-6">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2.5">
            <!-- Mini Emblem SVG -->
            <span class="w-9 h-9 rounded-xl bg-[#FDF2F4] border border-[#F3D1D8] flex items-center justify-center text-[#8B263E]" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
                <path d="M3 8l9 6 9-6"></path>
              </svg>
            </span>
            <h1 class="text-[26px] font-extrabold tracking-tight text-[#191F28]">축의대</h1>
          </div>
          <a href="#guide" id="homeGuideLink" class="btn-touch inline-flex items-center min-h-[44px] px-2 text-[14px] font-semibold text-[#4E5968] hover:text-[#8B263E] transition-colors">
            설치·사용 안내 보기 ›
          </a>
        </div>

        <!-- PWA Install Action Bar -->
        <button type="button" id="installAppBtn" class="btn-secondary w-full min-h-[48px] px-4 rounded-xl flex items-center justify-center gap-2 text-[14px] font-semibold text-[#191F28]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8B263E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>이 기기에 앱으로 설치</span>
        </button>
      </header>

      <!-- Saved Events List -->
      <section class="flex-1 flex flex-col gap-3 mb-6" aria-label="저장된 예식 목록">
        <div id="eventListContainer" class="flex flex-col gap-3"></div>
      </section>

      <!-- Primary & Secondary Bottom Actions -->
      <div class="flex flex-col gap-2.5 mt-auto pt-2">
        <button type="button" id="btnNewEvent" class="btn-primary w-full min-h-[54px] rounded-2xl text-[16px] font-bold shadow-sm flex items-center justify-center gap-1.5">
          <span>+ 새 예식 만들기</span>
        </button>

        <button type="button" id="btnImportBackup" class="btn-secondary w-full min-h-[48px] rounded-2xl text-[15px] font-semibold text-[#4E5968] flex items-center justify-center gap-2">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span>백업 파일 불러오기</span>
        </button>
        <input type="file" id="backupFileInput" accept=".json,application/json" class="hidden" />
      </div>
    </main>

    <!-- =====================================================================
         SCREEN 2: CREATE / EDIT EVENT SCREEN ('새 예식' / '예식 정보 수정')
         ===================================================================== -->
    <section id="eventFormScreen" class="hidden flex-1 flex flex-col">
      <!-- Sticky Top Header -->
      <header class="sticky top-0 z-20 bg-[#F7F7F5]/95 backdrop-blur-sm border-b border-[#E8E6E1] px-2 h-[56px] flex items-center justify-between">
        <button type="button" id="btnBackFromEventForm" aria-label="뒤로 가기" class="min-w-[48px] min-h-[48px] flex items-center justify-center text-[26px] font-medium text-[#191F28] rounded-xl hover:bg-black/5">
          ‹
        </button>
        <h2 id="eventFormTitle" class="text-[17px] font-bold text-[#191F28]">새 예식</h2>
        <div class="w-[48px]"></div>
      </header>

      <!-- Event Form Body -->
      <form id="eventForm" class="flex-1 px-5 py-5 flex flex-col gap-4" novalidate>
        <!-- Side Segmented Selector -->
        <div class="card-surface p-4">
          <label class="block text-[14px] font-bold text-[#191F28] mb-2.5">어느 쪽 축의대인가요?</label>
          <div class="grid grid-cols-2 gap-2 p-1 bg-[#F2F0EC] rounded-xl" role="group" aria-label="어느 쪽 축의대인가요?">
            <button type="button" id="sideGroomBtn" data-side="신랑측" class="min-h-[48px] rounded-lg text-[15px] font-bold transition-all bg-white text-[#8B263E] shadow-sm">
              신랑측
            </button>
            <button type="button" id="sideBrideBtn" data-side="신부측" class="min-h-[48px] rounded-lg text-[15px] font-bold transition-all text-[#4E5968]">
              신부측
            </button>
          </div>
        </div>

        <!-- Couple & Ceremony Info -->
        <div class="card-surface p-4 flex flex-col gap-4">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="inputGroomName" class="block text-[13px] font-bold text-[#191F28] mb-1.5">신랑 이름</label>
              <input type="text" id="inputGroomName" placeholder="예: 김민수" required class="w-full min-h-[48px] px-3.5 rounded-xl border border-[#E8E6E1] bg-[#FAFAF9] text-[15px] text-[#191F28] focus:outline-none focus:border-[#8B263E] focus:bg-white transition-colors" />
            </div>
            <div>
              <label for="inputBrideName" class="block text-[13px] font-bold text-[#191F28] mb-1.5">신부 이름</label>
              <input type="text" id="inputBrideName" placeholder="예: 이지은" required class="w-full min-h-[48px] px-3.5 rounded-xl border border-[#E8E6E1] bg-[#FAFAF9] text-[15px] text-[#191F28] focus:outline-none focus:border-[#8B263E] focus:bg-white transition-colors" />
            </div>
          </div>

          <div>
            <label for="inputEventDate" class="block text-[13px] font-bold text-[#191F28] mb-1.5">예식 날짜</label>
            <input type="date" id="inputEventDate" class="w-full min-h-[48px] px-3.5 rounded-xl border border-[#E8E6E1] bg-[#FAFAF9] text-[15px] text-[#191F28] focus:outline-none focus:border-[#8B263E] focus:bg-white transition-colors" />
          </div>

          <div>
            <label for="inputEventVenue" class="flex items-center gap-1.5 text-[13px] font-bold text-[#191F28] mb-1.5">
              <span>장소</span>
              <span class="px-1.5 py-0.5 text-[11px] font-semibold rounded bg-[#F2F0EC] text-[#6B7684]">선택</span>
            </label>
            <input type="text" id="inputEventVenue" placeholder="예: 더채플앳청담 3층" class="w-full min-h-[48px] px-3.5 rounded-xl border border-[#E8E6E1] bg-[#FAFAF9] text-[15px] text-[#191F28] focus:outline-none focus:border-[#8B263E] focus:bg-white transition-colors" />
          </div>

          <div>
            <label for="inputEventStaff" class="flex items-center gap-1.5 text-[13px] font-bold text-[#191F28] mb-1.5">
              <span>접수 담당자</span>
              <span class="px-1.5 py-0.5 text-[11px] font-semibold rounded bg-[#F2F0EC] text-[#6B7684]">선택</span>
            </label>
            <input type="text" id="inputEventStaff" placeholder="예: 홍길동" class="w-full min-h-[48px] px-3.5 rounded-xl border border-[#E8E6E1] bg-[#FAFAF9] text-[15px] text-[#191F28] focus:outline-none focus:border-[#8B263E] focus:bg-white transition-colors" />
          </div>
        </div>

        <!-- "누구 손님" Category Preset Manager -->
        <div class="card-surface p-4">
          <label class="block text-[14px] font-bold text-[#191F28] mb-1">"누구 손님" 선택지</label>
          <p class="text-[12px] text-[#6B7684] mb-3">접수 화면에서 빠르게 선택할 하객 구분 태그예요.</p>

          <!-- Removable Chips -->
          <div id="categoryPresetChips" class="flex flex-wrap gap-2 mb-3"></div>

          <!-- Add Custom Category -->
          <div class="flex gap-2">
            <input type="text" id="inputNewCategory" placeholder="직접 추가 (예: 대학동기)" maxlength="15" class="flex-1 min-h-[48px] px-3.5 rounded-xl border border-[#E8E6E1] bg-[#FAFAF9] text-[14px] text-[#191F28] focus:outline-none focus:border-[#8B263E] focus:bg-white" />
            <button type="button" id="btnAddCategory" class="btn-secondary min-h-[48px] px-4 rounded-xl text-[14px] font-bold text-[#8B263E] border-[#F3D1D8] bg-[#FDF2F4] hover:bg-[#F9E6EA]">
              추가
            </button>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="mt-auto pt-2 pb-4">
          <button type="submit" id="btnSaveEventForm" class="btn-primary w-full min-h-[54px] rounded-2xl text-[16px] font-bold shadow-sm">
            저장하고 시작
          </button>
        </div>
      </form>
    </section>

    <!-- =====================================================================
         SCREEN 3: MAIN RECEPTION SCREEN ('접수' / '목록' / '더보기')
         ===================================================================== -->
    <section id="receptionScreen" class="hidden flex-1 flex flex-col">
      <!-- Sticky Top Header -->
      <header class="sticky top-0 z-20 bg-[#F7F7F5]/95 backdrop-blur-sm border-b border-[#E8E6E1] px-2 h-[58px] flex items-center justify-between gap-2">
        <button type="button" id="btnBackToHome" aria-label="홈으로 이동" class="min-w-[48px] min-h-[48px] flex items-center justify-center text-[26px] font-medium text-[#191F28] rounded-xl hover:bg-black/5 shrink-0">
          ‹
        </button>
        <div class="flex-1 min-w-0">
          <h2 id="receptionHeaderTitle" class="text-[15px] font-bold text-[#191F28] truncate">신랑 ♥ 신부 · 신랑측</h2>
        </div>
        <div id="receptionLiveSummaryBadge" class="shrink-0 px-2.5 py-1.5 rounded-full bg-[#FDF2F4] border border-[#F3D1D8] text-[12px] font-bold text-[#8B263E]">
          총 0건 · 0원
        </div>
      </header>

      <!-- Closed Status Banner -->
      <div id="closedBanner" class="hidden bg-[#FFF4E5] border-b border-[#FFE0B2] px-4 py-3 flex items-center gap-2 text-[13px] font-semibold text-[#9A5B00]">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>접수가 마감되었습니다. 더보기에서 다시 열 수 있습니다.</span>
      </div>

      <!-- TAB 1: '접수' (Entry Form) -->
      <div id="tabReceive" class="flex-1 px-4 py-4 pb-24 flex flex-col gap-3.5">
        <!-- 1. 이름 Card -->
        <div class="card-surface p-4">
          <div class="flex items-center justify-between mb-2">
            <label for="entryNameInput" class="text-[14px] font-bold text-[#191F28]">이름</label>
            <label class="touch-label inline-flex items-center gap-2 min-h-[36px] px-2 -mr-2 rounded-lg cursor-pointer select-none">
              <input type="checkbox" id="entryUnknownNameCheck" class="w-4 h-4 accent-[#8B263E] rounded cursor-pointer" />
              <span class="text-[13px] font-semibold text-[#4E5968]">이름 확인 어려움</span>
            </label>
          </div>
          <input type="text" id="entryNameInput" placeholder="하객 성함 입력" autocomplete="off" class="w-full min-h-[48px] px-3.5 rounded-xl border border-[#E8E6E1] bg-[#FAFAF9] text-[16px] font-medium text-[#191F28] focus:outline-none focus:border-[#8B263E] focus:bg-white disabled:bg-[#F2F0EC] disabled:text-[#8B95A1] transition-colors" />
        </div>

        <!-- 2. 금액 Card -->
        <div class="card-surface p-4">
          <div class="flex items-center justify-between mb-2.5">
            <label for="entryAmountInput" class="text-[14px] font-bold text-[#191F28]">금액</label>
            <!-- Unit Toggle: 만원 | 원 -->
            <div class="inline-flex p-0.5 bg-[#F2F0EC] rounded-lg" role="group" aria-label="금액 단위 선택">
              <button type="button" id="unitManwonBtn" data-unit="만원" class="min-h-[34px] px-3 rounded-md text-[12px] font-bold bg-white text-[#8B263E] shadow-xs transition-all">
                만원
              </button>
              <button type="button" id="unitWonBtn" data-unit="원" class="min-h-[34px] px-3 rounded-md text-[12px] font-bold text-[#4E5968] transition-all">
                원
              </button>
            </div>
          </div>

          <!-- Quick-Add Buttons -->
          <div class="grid grid-cols-4 gap-1.5 mb-2.5">
            <button type="button" data-add-man="1" class="quick-amt-btn btn-secondary min-h-[44px] rounded-xl text-[13px] font-bold text-[#191F28]">+1만</button>
            <button type="button" data-add-man="3" class="quick-amt-btn btn-secondary min-h-[44px] rounded-xl text-[13px] font-bold text-[#191F28]">+3만</button>
            <button type="button" data-add-man="5" class="quick-amt-btn btn-secondary min-h-[44px] rounded-xl text-[13px] font-bold text-[#191F28]">+5만</button>
            <button type="button" data-add-man="10" class="quick-amt-btn btn-secondary min-h-[44px] rounded-xl text-[13px] font-bold text-[#191F28]">+10만</button>
            <button type="button" data-add-man="20" class="quick-amt-btn btn-secondary min-h-[44px] rounded-xl text-[13px] font-bold text-[#191F28]">+20만</button>
            <button type="button" data-add-man="30" class="quick-amt-btn btn-secondary min-h-[44px] rounded-xl text-[13px] font-bold text-[#191F28]">+30만</button>
            <button type="button" data-add-man="50" class="quick-amt-btn btn-secondary min-h-[44px] rounded-xl text-[13px] font-bold text-[#191F28]">+50만</button>
            <button type="button" id="btnResetAmount" class="min-h-[44px] rounded-xl text-[13px] font-bold text-[#6B7684] bg-[#F2F0EC] hover:bg-[#E7E4DD] transition-colors">초기화</button>
          </div>

          <!-- Numeric Amount Input with Trailing Unit -->
          <div class="relative flex items-center">
            <input type="number" id="entryAmountInput" inputmode="numeric" min="0" placeholder="0" class="w-full min-h-[52px] pl-3.5 pr-14 rounded-xl border border-[#E8E6E1] bg-[#FAFAF9] text-[20px] font-extrabold text-right text-[#191F28] focus:outline-none focus:border-[#8B263E] focus:bg-white disabled:bg-[#F2F0EC] transition-colors" />
            <span id="entryAmountUnitLabel" class="absolute right-4 text-[15px] font-bold text-[#4E5968] pointer-events-none">만원</span>
          </div>

          <!-- Live Korean Currency Readout -->
          <div id="entryAmountPreview" class="mt-2 text-right text-[13px] font-bold text-[#8B263E] min-h-[20px]">
            0원
          </div>
        </div>

        <!-- 3. 누구 손님 Card -->
        <div class="card-surface p-4">
          <div class="flex items-center gap-1.5 mb-2.5">
            <span class="text-[14px] font-bold text-[#191F28]">누구 손님</span>
            <span class="px-1.5 py-0.5 text-[11px] font-semibold rounded bg-[#F2F0EC] text-[#6B7684]">선택</span>
          </div>
          <div id="entryCategoryChips" class="flex flex-wrap gap-2"></div>
        </div>

        <!-- 4. 메모 & 식권 Card -->
        <div class="card-surface p-4 flex flex-col gap-4">
          <!-- 메모 -->
          <div>
            <div class="flex items-center gap-1.5 mb-2">
              <label for="entryMemoInput" class="text-[14px] font-bold text-[#191F28]">메모</label>
              <span class="px-1.5 py-0.5 text-[11px] font-semibold rounded bg-[#F2F0EC] text-[#6B7684]">선택</span>
            </div>
            <div class="flex flex-wrap gap-1.5 mb-2" id="quickMemoChips">
              <button type="button" data-memo="계좌이체" class="memo-chip min-h-[36px] px-3 rounded-full text-[12px] font-semibold border border-[#E8E6E1] bg-[#FAFAF9] text-[#4E5968] hover:border-[#8B263E]">계좌이체</button>
              <button type="button" data-memo="봉투만" class="memo-chip min-h-[36px] px-3 rounded-full text-[12px] font-semibold border border-[#E8E6E1] bg-[#FAFAF9] text-[#4E5968] hover:border-[#8B263E]">봉투만</button>
