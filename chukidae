            row.className = 'p-3.5 rounded-2xl bg-[#FAFAF9] border border-[#E8E6E1] flex flex-col gap-1.5';
            row.innerHTML = `
              <div class="flex items-center justify-between gap-2">
                <span class="px-2 py-0.5 rounded-md border text-[11.5px] font-extrabold ${badgeStyle}">
                  ${escapeHtml(log.action)}
                </span>
                <span class="text-[11.5px] text-[#8B95A1]">${formatDateTimeFull(log.timestamp)}</span>
              </div>
              <p class="text-[13px] text-[#191F28] leading-snug break-keep">
                ${escapeHtml(log.detail)}
              </p>
            `;
            container.appendChild(row);
          });
        }

        openModal('historyModal');
      }

