  <script>
    /**
     * 축의대 (Chuguidae) - Offline-First Korean Wedding Monetary Gift Ledger PWA
     * Complete client-side application state, storage persistence, formatting helpers,
     * Excel (.xlsx) multi-sheet export, JSON backup/restore, and audit logging.
     */
    (function () {
      'use strict';

      /* =====================================================================
         1. CONSTANTS & STORAGE KEYS
         ===================================================================== */
      const STORAGE_KEYS = {
        WELCOMED: 'chuguidae_welcomed_v1',
        EVENTS: 'chuguidae_events_v1'
      };

      const DEFAULT_CATEGORIES = {
        '신랑측': ['신랑 본인', '신랑 부', '신랑 모', '친척', '회사', '친구'],
        '신부측': ['신부 본인', '신부 부', '신부 모', '친척', '회사', '친구']
      };

      /* =====================================================================
         2. APPLICATION STATE
         ===================================================================== */
      let events = [];
      let activeEventId = null;
      let activeTab = 'receive'; // 'receive' | 'list' | 'more'
      let deferredInstallPrompt = null;

      // Create / Edit Event Form State
      let editingEventId = null; // null = create mode, string = edit mode
      let formSide = '신랑측';
      let formCategories = [...DEFAULT_CATEGORIES['신랑측']];
      let categoriesManuallyEdited = false;

      // Reception Entry Form State
      let entryUnit = '만원'; // '만원' | '원'
      let selectedCategory = '';
      let ticketCount = 0;

      // List Tab Filter & Sort State
      let listSearchQuery = '';
      let listActiveFilter = '전체';
      let listSortDesc = true; // true = 최신순 (#N -> #1), false = 번호순 (#1 -> #N)

      // Edit Entry Modal State
      let editingEntrySeq = null;
      let editSelectedCategory = '';

      /* =====================================================================
         3. PWA DYNAMIC MANIFEST & SVG ICON SETUP (No external files needed)
         ===================================================================== */
      function initPwaAssets() {
        try {
          const iconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192" width="192" height="192"><rect width="192" height="192" rx="42" fill="#8B263E"/><rect x="34" y="54" width="124" height="84" rx="12" fill="#FFFFFF"/><path d="M36 62L96 104L156 62" fill="none" stroke="#8B263E" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="96" cy="102" r="14" fill="#8B263E"/></svg>`;
          const svgUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(iconSvg);
          document.getElementById('appFavicon').setAttribute('href', svgUrl);
          document.getElementById('appleTouchIcon').setAttribute('href', svgUrl);

          const manifestObj = {
            name: '축의대 - 결혼식 축의금 접수 장부',
            short_name: '축의대',
            description: '결혼식 축의금 접수를 실수 없이 기록하고 엑셀로 바로 정리하는 앱',
            start_url: '.',
            display: 'standalone',
            background_color: '#F7F7F5',
            theme_color: '#F7F7F5',
            icons: [
              {
                src: svgUrl,
                sizes: '192x192',
                type: 'image/svg+xml',
                purpose: 'any maskable'
              }
            ]
          };
          const manifestBlob = new Blob([JSON.stringify(manifestObj)], { type: 'application/manifest+json' });
          document.getElementById('webManifest').setAttribute('href', URL.createObjectURL(manifestBlob));
        } catch (err) {
          console.warn('PWA manifest setup skipped:', err);
        }

        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          deferredInstallPrompt = e;
        });
      }

      /* =====================================================================
         4. STORAGE & UTILITY HELPERS
         ===================================================================== */
      function loadEventsFromStorage() {
        try {
          const raw = localStorage.getItem(STORAGE_KEYS.EVENTS);
          if (!raw) return [];
          const parsed = JSON.parse(raw);
          return Array.isArray(parsed) ? parsed : [];
        } catch (err) {
          console.error('Failed to read from localStorage:', err);
          showToast('저장된 데이터를 불러오는 중 오류가 발생했습니다.', 'error');
          return [];
        }
      }

      function saveEventsToStorage() {
        try {
          localStorage.setItem(STORAGE_KEYS.EVENTS, JSON.stringify(events));
        } catch (err) {
          console.error('Failed to save to localStorage:', err);
          showToast('기기 저장 공간이 부족하여 저장에 실패했습니다.', 'error');
        }
      }

      function getActiveEvent() {
        return events.find((evt) => evt.id === activeEventId) || null;
      }

      function generateId(prefix) {
        return `${prefix}_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;
      }

      function getTodayDateString() {
        const now = new Date();
        const y = now.getFullYear();
        const m = String(now.getMonth() + 1).padStart(2, '0');
        const d = String(now.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
      }

      function formatTimeShort(isoStr) {
        if (!isoStr) return '';
        const d = new Date(isoStr);
        if (Number.isNaN(d.getTime())) return '';
        const hh = String(d.getHours()).padStart(2, '0');
        const mm = String(d.getMinutes()).padStart(2, '0');
        return `${hh}:${mm}`;
      }

      function formatDateTimeFull(isoStr) {
        if (!isoStr) return '';
        const d = new Date(isoStr);
        if (Number.isNaN(d.getTime())) return '';
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        const hh = String(d.getHours()).padStart(2, '0');
        const mm = String(d.getMinutes()).padStart(2, '0');
        const ss = String(d.getSeconds()).padStart(2, '0');
        return `${y}.${m}.${day} ${hh}:${mm}:${ss}`;
      }

      function formatDateKorean(dateStr) {
        if (!dateStr) return '날짜 미지정';
        const parts = dateStr.split('-');
        if (parts.length !== 3) return dateStr;
        return `${parts[0]}년 ${Number(parts[1])}월 ${Number(parts[2])}일`;
      }

      function escapeHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      /**
       * Converts integer amount in KRW to natural Korean words (e.g. 50000 -> '오만', 1250000 -> '백이십오만')
       */
      function numberToKoreanWords(num) {
        if (!num || num <= 0) return '';
        const digits = ['', '일', '이', '삼', '사', '오', '육', '칠', '팔', '구'];
        const smallUnits = ['', '십', '백', '천'];
        const bigUnits = ['', '만', '억', '조'];

        let result = '';
        let bigIndex = 0;
        let n = Math.floor(num);

        while (n > 0) {
          const chunk = n % 10000;
          if (chunk > 0) {
            let chunkStr = '';
            let temp = chunk;
            for (let i = 0; i < 4; i++) {
              const d = temp % 10;
              if (d > 0) {
                // Omit '일' before 십/백/천 (e.g., 10 -> 십, 150000 -> 십오만)
                // Keep '일' if it's the ones place of a big unit like '일만' only when standalone, though standard Korean prefers '만' or '일만'
                const digitWord = (d === 1 && i > 0) ? '' : digits[d];
                chunkStr = digitWord + smallUnits[i] + chunkStr;
              }
              temp = Math.floor(temp / 10);
            }
            if (chunkStr === '일' && bigIndex === 1 && n < 100000) {
              // 10,000 -> '만원' (more natural than '일만원')
              chunkStr = '';
            }
            result = chunkStr + bigUnits[bigIndex] + result;
          }
          n = Math.floor(n / 10000);
          bigIndex++;
        }
        return result;
      }

      /**
       * Formats KRW integer into '50,000원 (오만원)'
       */
      function formatKoreanWonFull(amount) {
        const val = Math.max(0, Math.floor(Number(amount) || 0));
        if (val === 0) return '0원';
        const formattedDigits = val.toLocaleString('ko-KR') + '원';
        const koreanWords = numberToKoreanWords(val);
        return koreanWords ? `${formattedDigits} (${koreanWords}원)` : formattedDigits;
      }

      /**
       * Formats KRW integer into compact header badge text (e.g. '145만원', '145.5만원', '8,000원')
       */
      function formatCompactManwon(amount) {
        const val = Math.max(0, Math.floor(Number(amount) || 0));
        if (val === 0) return '0원';
        if (val >= 10000 && val % 10000 === 0) {
          return `${(val / 10000).toLocaleString('ko-KR')}만원`;
        }
        if (val >= 10000 && val % 1000 === 0) {
          return `${(val / 10000).toLocaleString('ko-KR')}만원`;
        }
        return `${val.toLocaleString('ko-KR')}원`;
      }

      /**
       * Non-blocking Custom Toast Message (Replaces native alert())
       */
      function showToast(message, type = 'default') {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        const bgClass =
          type === 'error'
            ? 'bg-[#991B1B] text-white'
            : type === 'success'
            ? 'bg-[#191F28] text-white'
            : 'bg-[#191F28] text-white';

        toast.className = `${bgClass} px-4 py-3 rounded-2xl shadow-lg text-[13.5px] font-semibold leading-snug text-center animate-slide-up pointer-events-auto`;
        toast.textContent = message;
        container.appendChild(toast);

        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transition = 'opacity 0.2s ease';
          setTimeout(() => toast.remove(), 220);
        }, 2800);
      }

      function appendHistoryLog(eventObj, action, detail) {
        if (!Array.isArray(eventObj.history)) {
          eventObj.history = [];
        }
        eventObj.history.push({
          id: generateId('log'),
          timestamp: new Date().toISOString(),
          action,
          detail
        });
      }

      /* =====================================================================
         5. NAVIGATION & MODAL CONTROLLERS
         ===================================================================== */
      function showScreen(screenId) {
        ['homeScreen', 'eventFormScreen', 'receptionScreen'].forEach((id) => {
          const el = document.getElementById(id);
          if (id === screenId) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
        window.scrollTo({ top: 0, behavior: 'instant' });
      }

      function openModal(modalId) {
        document.getElementById(modalId).classList.remove('hidden');
      }

      function closeModal(modalId) {
        document.getElementById(modalId).classList.add('hidden');
      }

      /* =====================================================================
         6. SCREEN 1: HOME SCREEN RENDERING & ACTIONS
         ===================================================================== */
      function renderHomeScreen() {
        const container = document.getElementById('eventListContainer');
        container.innerHTML = '';

        if (events.length === 0) {
          container.innerHTML = `
            <div class="card-surface p-7 text-center my-2">
              <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-[#F2F0EC] text-[#6B7684] flex items-center justify-center">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="12" y1="18" x2="12" y2="12"></line>
                  <line x1="9" y1="15" x2="15" y2="15"></line>
                </svg>
              </div>
              <p class="text-[15px] font-bold text-[#191F28] mb-1">등록된 예식이 아직 없어요</p>
              <p class="text-[13px] text-[#6B7684] leading-relaxed">
                아래 <strong>‘+ 새 예식 만들기’</strong> 버튼을 눌러<br />축의금 접수를 바로 시작해보세요.
              </p>
            </div>
          `;
          return;
        }

        // Render newest updated/created events first
        const sortedEvents = [...events].sort((a, b) => new Date(b.updatedAt || b.createdAt) - new Date(a.updatedAt || a.createdAt));

        sortedEvents.forEach((evt) => {
          const validEntries = (evt.entries || []).filter((e) => !e.cancelled);
          const totalAmount = validEntries.reduce((sum, e) => sum + (Number(e.amount) || 0), 0);
          const isGroom = evt.side === '신랑측';

          const sideBadgeClass = isGroom
            ? 'bg-[#EEF2F6] text-[#2B4C7E] border-[#D6E0EC]'
            : 'bg-[#FDF2F4] text-[#8B263E] border-[#F3D1D8]';

          const card = document.createElement('button');
          card.type = 'button';
          card.className =
            'card-surface w-full p-4 text-left hover:border-[#8B263E]/40 active:scale-[0.99] transition-all flex flex-col gap-2.5';

          const metaParts = [formatDateKorean(evt.date)];
          if (evt.venue) metaParts.push(evt.venue);

          card.innerHTML = `
            <div class="flex items-center justify-between gap-2 w-full">
              <div class="flex items-center gap-1.5">
                <span class="px-2.5 py-0.5 rounded-md border text-[12px] font-extrabold ${sideBadgeClass}">
                  ${escapeHtml(evt.side)}
                </span>
                ${
                  evt.isClosed
                    ? '<span class="px-2 py-0.5 rounded-md bg-[#F2F0EC] text-[#6B7684] text-[11px] font-bold">마감됨</span>'
                    : ''
                }
              </div>
              <span class="text-[#8B95A1] text-[18px] leading-none">›</span>
            </div>

            <div class="w-full">
              <div class="text-[18px] font-extrabold text-[#191F28] tracking-tight">
                ${escapeHtml(evt.groomName)} <span class="text-[#8B263E] text-[15px]">♥</span> ${escapeHtml(evt.brideName)}
              </div>
              <div class="text-[13px] text-[#6B7684] mt-0.5 truncate">
                ${escapeHtml(metaParts.join(' · '))}
              </div>
            </div>

            <div class="w-full pt-2.5 border-t border-[#F2F0EC] flex items-center justify-between text-[13px]">
              <span class="font-semibold text-[#4E5968]">유효 접수 <strong>${validEntries.length}건</strong></span>
              <span class="font-extrabold text-[#8B263E] text-[15px]">${totalAmount.toLocaleString('ko-KR')}원</span>
            </div>
          `;

          card.addEventListener('click', () => {
            openEventReception(evt.id);
          });

          container.appendChild(card);
        });
      }

      /* =====================================================================
         7. SCREEN 2: CREATE / EDIT EVENT SCREEN LOGIC
         ===================================================================== */
      function openEventForm(eventToEdit = null) {
        editingEventId = eventToEdit ? eventToEdit.id : null;
        categoriesManuallyEdited = Boolean(eventToEdit);

        document.getElementById('eventFormTitle').textContent = eventToEdit ? '예식 정보 수정' : '새 예식';
        document.getElementById('btnSaveEventForm').textContent = eventToEdit ? '수정 내용 저장' : '저장하고 시작';

        formSide = eventToEdit ? eventToEdit.side : '신랑측';
        formCategories = eventToEdit
          ? [...(eventToEdit.categories || [])]
          : [...DEFAULT_CATEGORIES['신랑측']];

        document.getElementById('inputGroomName').value = eventToEdit ? eventToEdit.groomName : '';
        document.getElementById('inputBrideName').value = eventToEdit ? eventToEdit.brideName : '';
        document.getElementById('inputEventDate').value = eventToEdit ? eventToEdit.date : getTodayDateString();
        document.getElementById('inputEventVenue').value = eventToEdit ? (eventToEdit.venue || '') : '';
        document.getElementById('inputEventStaff').value = eventToEdit ? (eventToEdit.staff || '') : '';
        document.getElementById('inputNewCategory').value = '';

        updateSideSegmentedUI();
        renderCategoryPresetChips();
        showScreen('eventFormScreen');
      }

      function updateSideSegmentedUI() {
        const groomBtn = document.getElementById('sideGroomBtn');
        const brideBtn = document.getElementById('sideBrideBtn');

        if (formSide === '신랑측') {
          groomBtn.className = 'min-h-[48px] rounded-lg text-[15px] font-bold transition-all bg-white text-[#8B263E] shadow-sm';
          brideBtn.className = 'min-h-[48px] rounded-lg text-[15px] font-bold transition-all text-[#4E5968]';
        } else {
          brideBtn.className = 'min-h-[48px] rounded-lg text-[15px] font-bold transition-all bg-white text-[#8B263E] shadow-sm';
          groomBtn.className = 'min-h-[48px] rounded-lg text-[15px] font-bold transition-all text-[#4E5968]';
        }
      }

      function renderCategoryPresetChips() {
        const container = document.getElementById('categoryPresetChips');
        container.innerHTML = '';

        if (formCategories.length === 0) {
          container.innerHTML = '<span class="text-[12px] text-[#8B95A1]">등록된 선택지가 없습니다. 아래에서 추가해주세요.</span>';
          return;
        }

        formCategories.forEach((cat, idx) => {
          const chip = document.createElement('span');
          chip.className = 'inline-flex items-center gap-1.5 min-h-[38px] pl-3 pr-2 rounded-full bg-[#FDF2F4] border border-[#F3D1D8] text-[13px] font-bold text-[#8B263E]';
          chip.innerHTML = `
            <span>${escapeHtml(cat)}</span>
            <button type="button" aria-label="${escapeHtml(cat)} 삭제" class="w-6 h-6 rounded-full hover:bg-[#8B263E]/15 flex items-center justify-center text-[13px] leading-none">✕</button>
          `;
          chip.querySelector('button').addEventListener('click', () => {
            formCategories.splice(idx, 1);
            categoriesManuallyEdited = true;
            renderCategoryPresetChips();
          });
          container.appendChild(chip);
        });
      }

      function handleAddCustomCategory() {
        const input = document.getElementById('inputNewCategory');
        const val = input.value.trim();
        if (!val) return;
        if (formCategories.includes(val)) {
          showToast('이미 등록된 선택지입니다.');
          input.value = '';
          return;
        }
        formCategories.push(val);
        categoriesManuallyEdited = true;
        input.value = '';
        renderCategoryPresetChips();
      }

      function handleSaveEventForm(e) {
        e.preventDefault();
        const groomName = document.getElementById('inputGroomName').value.trim();
        const brideName = document.getElementById('inputBrideName').value.trim();
        const date = document.getElementById('inputEventDate').value || getTodayDateString();
        const venue = document.getElementById('inputEventVenue').value.trim();
        const staff = document.getElementById('inputEventStaff').value.trim();

        if (!groomName) {
          showToast('신랑 이름을 입력해주세요.', 'error');
          document.getElementById('inputGroomName').focus();
          return;
        }
        if (!brideName) {
          showToast('신부 이름을 입력해주세요.', 'error');
          document.getElementById('inputBrideName').focus();
          return;
        }

        const nowIso = new Date().toISOString();

        if (editingEventId) {
          // Update existing event
          const target = events.find((ev) => ev.id === editingEventId);
          if (!target) return;

          const diffs = [];
          if (target.side !== formSide) diffs.push(`구분: ${target.side} → ${formSide}`);
          if (target.groomName !== groomName) diffs.push(`신랑: ${target.groomName} → ${groomName}`);
          if (target.brideName !== brideName) diffs.push(`신부: ${target.brideName} → ${brideName}`);
          if (target.date !== date) diffs.push(`날짜: ${target.date} → ${date}`);
          if ((target.venue || '') !== venue) diffs.push(`장소: '${target.venue || '없음'}' → '${venue || '없음'}'`);
          if ((target.staff || '') !== staff) diffs.push(`담당자: '${target.staff || '없음'}' → '${staff || '없음'}'`);
          if (JSON.stringify(target.categories) !== JSON.stringify(formCategories)) {
            diffs.push(`누구 손님 선택지 변경 (${formCategories.join(', ')})`);
          }

          target.side = formSide;
          target.groomName = groomName;
          target.brideName = brideName;
          target.date = date;
          target.venue = venue;
          target.staff = staff;
          target.categories = [...formCategories];
          target.updatedAt = nowIso;

          appendHistoryLog(
            target,
            '예식 정보 수정',
            diffs.length > 0 ? diffs.join(', ') : '예식 정보 저장 (변경 항목 없음)'
          );

          saveEventsToStorage();
          showToast('예식 정보가 수정되었습니다.', 'success');
          openEventReception(target.id);
        } else {
          // Create new event
          const newEvent = {
            id: generateId('evt'),
            side: formSide,
            groomName,
            brideName,
            date,
            venue,
            staff,
            categories: [...formCategories],
            isClosed: false,
            createdAt: nowIso,
            updatedAt: nowIso,
            entries: [],
            history: []
          };

          appendHistoryLog(
            newEvent,
            '예식 생성',
            `${groomName} ♥ ${brideName} (${formSide}, ${formatDateKorean(date)})`
          );

          events.push(newEvent);
          saveEventsToStorage();
          showToast('새 예식이 생성되었습니다.', 'success');
          openEventReception(newEvent.id);
        }
      }

      /* =====================================================================
         8. SCREEN 3: MAIN RECEPTION SCREEN & TABS
         ===================================================================== */
      function openEventReception(eventId) {
        activeEventId = eventId;
        activeTab = 'receive';
        listSearchQuery = '';
        listActiveFilter = '전체';
        document.getElementById('listSearchInput').value = '';
        document.getElementById('btnClearSearch').classList.add('hidden');

        resetReceiveForm();
        updateReceptionHeaderAndClosedState();
        switchReceptionTab('receive');
        showScreen('receptionScreen');
      }

      function updateReceptionHeaderAndClosedState() {
        const evt = getActiveEvent();
        if (!evt) return;

        document.getElementById('receptionHeaderTitle').textContent =
          `${evt.groomName} ♥ ${evt.brideName} · ${evt.side}`;

        const validEntries = (evt.entries || []).filter((e) => !e.cancelled);
        const totalAmount = validEntries.reduce((sum, e) => sum + (Number(e.amount) || 0), 0);

        document.getElementById('receptionLiveSummaryBadge').textContent =
          `총 ${validEntries.length}건 · ${formatCompactManwon(totalAmount)}`;

        document.getElementById('navListCountBadge').textContent = String(validEntries.length);

        // Closed state UI synchronization
        const closedBanner = document.getElementById('closedBanner');
        const isClosed = Boolean(evt.isClosed);

        if (isClosed) {
          closedBanner.classList.remove('hidden');
        } else {
          closedBanner.classList.add('hidden');
        }

        // Disable/enable inputs in Receive Tab when closed
        const receiveControls = document.querySelectorAll('#tabReceive input, #tabReceive button');
        receiveControls.forEach((ctrl) => {
          if (ctrl.id === 'entryNameInput') {
            ctrl.disabled = isClosed || document.getElementById('entryUnknownNameCheck').checked;
          } else {
            ctrl.disabled = isClosed;
          }
        });

        // Update More Tab toggle button label
        const toggleCloseLabel = document.getElementById('toggleCloseLabel');
        const toggleCloseSublabel = document.getElementById('toggleCloseSublabel');
        const toggleCloseIconWrap = document.getElementById('toggleCloseIconWrap');

        if (isClosed) {
          toggleCloseLabel.textContent = '접수 다시 열기';
          toggleCloseLabel.className = 'text-[15px] font-bold text-[#059669]';
          toggleCloseSublabel.textContent = '마감을 해제하고 축의금 접수를 재개합니다';
          toggleCloseIconWrap.className = 'w-10 h-10 rounded-xl bg-[#ECFDF5] text-[#059669] flex items-center justify-center shrink-0';
        } else {
          toggleCloseLabel.textContent = '접수 마감';
          toggleCloseLabel.className = 'text-[15px] font-bold text-[#8B263E]';
          toggleCloseSublabel.textContent = '마감 후에는 신규 접수가 잠깁니다';
          toggleCloseIconWrap.className = 'w-10 h-10 rounded-xl bg-[#FDF2F4] text-[#8B263E] flex items-center justify-center shrink-0';
        }
      }

      function switchReceptionTab(tabName) {
        activeTab = tabName;
        const tabs = ['receive', 'list', 'more'];

        tabs.forEach((t) => {
          const panel = document.getElementById(`tab${t.charAt(0).toUpperCase() + t.slice(1)}`);
          const navBtn = document.getElementById(`navTab${t.charAt(0).toUpperCase() + t.slice(1)}`);

          if (t === tabName) {
            panel.classList.remove('hidden');
            navBtn.classList.remove('text-[#6B7684]', 'font-semibold');
            navBtn.classList.add('text-[#8B263E]', 'font-bold');
          } else {
            panel.classList.add('hidden');
            navBtn.classList.remove('text-[#8B263E]', 'font-bold');
            navBtn.classList.add('text-[#6B7684]', 'font-semibold');
          }
        });

        if (tabName === 'receive') {
          renderReceiveCategoryChips();
        } else if (tabName === 'list') {
          renderListTab();
        }
      }

      /* ---------------------------------------------------------------------
         TAB 1: '접수' FORM LOGIC
         --------------------------------------------------------------------- */
      function resetReceiveForm() {
        const nameInput = document.getElementById('entryNameInput');
        const unknownCheck = document.getElementById('entryUnknownNameCheck');
        unknownCheck.checked = false;
        nameInput.disabled = false;
        nameInput.value = '';

        document.getElementById('entryAmountInput').value = '';
        updateReceiveAmountPreview();

        selectedCategory = '';
        renderReceiveCategoryChips();

        document.getElementById('entryMemoInput').value = '';
        syncQuickMemoChipsUI();

        ticketCount = 0;
        updateReceiveTicketUI();
      }

      function getReceiveAmountInWon() {
        const raw = Number(document.getElementById('entryAmountInput').value) || 0;
        if (raw <= 0) return 0;
        return entryUnit === '만원' ? Math.round(raw * 10000) : Math.round(raw);
      }

      function updateReceiveAmountPreview() {
        const won = getReceiveAmountInWon();
        document.getElementById('entryAmountPreview').textContent = formatKoreanWonFull(won);
      }

      function switchEntryUnit(newUnit) {
        if (entryUnit === newUnit) return;
        const currentWon = getReceiveAmountInWon();
        entryUnit = newUnit;

        const manBtn = document.getElementById('unitManwonBtn');
        const wonBtn = document.getElementById('unitWonBtn');
        const unitLabel = document.getElementById('entryAmountUnitLabel');
        const amtInput = document.getElementById('entryAmountInput');

        if (entryUnit === '만원') {
          manBtn.className = 'min-h-[34px] px-3 rounded-md text-[12px] font-bold bg-white text-[#8B263E] shadow-xs transition-all';
          wonBtn.className = 'min-h-[34px] px-3 rounded-md text-[12px] font-bold text-[#4E5968] transition-all';
          unitLabel.textContent = '만원';
          amtInput.value = currentWon > 0 ? currentWon / 10000 : '';
        } else {
          wonBtn.className = 'min-h-[34px] px-3 rounded-md text-[12px] font-bold bg-white text-[#8B263E] shadow-xs transition-all';
          manBtn.className = 'min-h-[34px] px-3 rounded-md text-[12px] font-bold text-[#4E5968] transition-all';
          unitLabel.textContent = '원';
          amtInput.value = currentWon > 0 ? currentWon : '';
        }

        updateReceiveAmountPreview();
      }

      function handleQuickAddManwon(manAmount) {
        const currentWon = getReceiveAmountInWon();
        const nextWon = currentWon + manAmount * 10000;
        const amtInput = document.getElementById('entryAmountInput');
        amtInput.value = entryUnit === '만원' ? nextWon / 10000 : nextWon;
        updateReceiveAmountPreview();
      }

      function renderReceiveCategoryChips() {
        const evt = getActiveEvent();
        const container = document.getElementById('entryCategoryChips');
        container.innerHTML = '';
        if (!evt) return;

        const cats = evt.categories || [];
        if (cats.length === 0) {
          container.innerHTML = '<span class="text-[12px] text-[#8B95A1]">설정된 하객 구분이 없습니다. (더보기 &gt; 예식 정보 수정에서 추가 가능)</span>';
          return;
        }

        cats.forEach((cat) => {
          const isSelected = selectedCategory === cat;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.disabled = Boolean(evt.isClosed);
          btn.className = isSelected
            ? 'min-h-[42px] px-3.5 rounded-xl text-[14px] font-bold bg-[#8B263E] text-white border border-[#8B263E] shadow-xs transition-all'
            : 'min-h-[42px] px-3.5 rounded-xl text-[14px] font-semibold bg-[#FAFAF9] text-[#4E5968] border border-[#E8E6E1] hover:border-[#8B263E]/50 transition-all';
          btn.textContent = cat;

          btn.addEventListener('click', () => {
            selectedCategory = selectedCategory === cat ? '' : cat;
            renderReceiveCategoryChips();
          });

          container.appendChild(btn);
        });
      }

      function syncQuickMemoChipsUI() {
        const memoVal = document.getElementById('entryMemoInput').value;
        document.querySelectorAll('#quickMemoChips .memo-chip').forEach((btn) => {
          const tag = btn.getAttribute('data-memo');
          const active = memoVal.includes(tag);
          btn.className = active
            ? 'memo-chip min-h-[36px] px-3 rounded-full text-[12px] font-bold border border-[#8B263E] bg-[#FDF2F4] text-[#8B263E] transition-colors'
            : 'memo-chip min-h-[36px] px-3 rounded-full text-[12px] font-semibold border border-[#E8E6E1] bg-[#FAFAF9] text-[#4E5968] hover:border-[#8B263E] transition-colors';
        });
      }

      function updateReceiveTicketUI() {
        document.getElementById('entryTicketDisplay').textContent = `${ticketCount}매`;
        document.querySelectorAll('#quickTicketPills .ticket-pill').forEach((btn) => {
          const val = Number(btn.getAttribute('data-ticket'));
          btn.className =
            val === ticketCount
              ? 'ticket-pill min-h-[40px] rounded-xl text-[13px] font-bold border border-[#8B263E] bg-[#FDF2F4] text-[#8B263E] transition-colors'
              : 'ticket-pill min-h-[40px] rounded-xl text-[13px] font-bold border border-[#E8E6E1] bg-white text-[#4E5968] transition-colors';
        });
      }

      function handleSaveNewEntry() {
        const evt = getActiveEvent();
        if (!evt) return;

        if (evt.isClosed) {
          showToast('접수가 마감된 상태입니다.', 'error');
          return;
        }

        const unknownName = document.getElementById('entryUnknownNameCheck').checked;
        const rawName = document.getElementById('entryNameInput').value.trim();
        const finalName = unknownName ? '이름 확인 어려움' : rawName;

        if (!unknownName && !rawName) {
          showToast('이름을 입력하거나 "이름 확인 어려움"을 체크해주세요.', 'error');
          document.getElementById('entryNameInput').focus();
          return;
        }

        const amountWon = getReceiveAmountInWon();
        if (amountWon <= 0) {
          showToast('축의금 금액을 입력해주세요.', 'error');
          document.getElementById('entryAmountInput').focus();
          return;
        }

        const memo = document.getElementById('entryMemoInput').value.trim();
        const nextSeq = (evt.entries ? evt.entries.length : 0) + 1;
        const nowIso = new Date().toISOString();

        const newEntry = {
          seq: nextSeq,
          id: generateId('ent'),
          name: finalName,
          unknownName,
          amount: amountWon,
          category: selectedCategory,
          memo,
          tickets: ticketCount,
          cancelled: false,
          createdAt: nowIso,
          updatedAt: nowIso
        };

        evt.entries.push(newEntry);
        evt.updatedAt = nowIso;

        const logParts = [
          `#${nextSeq} ${finalName}`,
          `${amountWon.toLocaleString('ko-KR')}원`
        ];
        if (selectedCategory) logParts.push(selectedCategory);
        if (ticketCount > 0) logParts.push(`식권 ${ticketCount}매`);
        if (memo) logParts.push(`메모: ${memo}`);

        appendHistoryLog(evt, '신규 접수', logParts.join(' · '));
        saveEventsToStorage();

        updateReceptionHeaderAndClosedState();
        resetReceiveForm();

        showToast(`#${nextSeq} ${finalName} · ${amountWon.toLocaleString('ko-KR')}원 저장 완료`, 'success');
      }

      /* ---------------------------------------------------------------------
         TAB 2: '목록' SUMMARY, FILTERING & LIST RENDERING
         --------------------------------------------------------------------- */
      function renderListTab() {
        const evt = getActiveEvent();
        if (!evt) return;

        const allEntries = evt.entries || [];
        const validEntries = allEntries.filter((e) => !e.cancelled);
        const cancelledCount = allEntries.length - validEntries.length;

        const totalAmount = validEntries.reduce((sum, e) => sum + (Number(e.amount) || 0), 0);
        const totalTickets = validEntries.reduce((sum, e) => sum + (Number(e.tickets) || 0), 0);

        // Category breakdown among valid entries
        const catStatsMap = new Map();
        (evt.categories || []).forEach((c) => {
          catStatsMap.set(c, { count: 0, amount: 0 });
        });

        validEntries.forEach((e) => {
          const key = e.category || '미지정';
          if (!catStatsMap.has(key)) {
            catStatsMap.set(key, { count: 0, amount: 0 });
          }
          const stat = catStatsMap.get(key);
          stat.count += 1;
          stat.amount += Number(e.amount) || 0;
        });

        const breakdownRows = [];
        catStatsMap.forEach((stat, key) => {
          if (stat.count > 0 || (evt.categories || []).includes(key)) {
            breakdownRows.push({ label: key, ...stat });
          }
        });

        // Render Summary Card
        const summaryCard = document.getElementById('listSummaryCard');
        summaryCard.innerHTML = `
          <div class="grid grid-cols-3 gap-2 pb-3.5 border-b border-[#F2F0EC]">
            <div>
              <div class="text-[12px] font-semibold text-[#6B7684]">유효 접수</div>
              <div class="text-[18px] font-extrabold text-[#191F28] mt-0.5">${validEntries.length}건</div>
              ${cancelledCount > 0 ? `<div class="text-[11px] text-red-500 font-semibold">취소 ${cancelledCount}건</div>` : ''}
            </div>
            <div class="col-span-2 text-right">
              <div class="text-[12px] font-semibold text-[#6B7684]">총 축의금액 · 식권 ${totalTickets}매</div>
              <div class="text-[20px] font-extrabold text-[#8B263E] mt-0.5">${totalAmount.toLocaleString('ko-KR')}원</div>
              <div class="text-[11px] font-semibold text-[#6B7684]">${totalAmount > 0 ? numberToKoreanWords(totalAmount) + '원' : ''}</div>
            </div>
          </div>

          <div class="pt-3">
            <div class="text-[12px] font-bold text-[#4E5968] mb-2">누구 손님별 집계</div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
              ${breakdownRows
                .map(
                  (r) => `
                  <div class="flex items-center justify-between text-[12.5px] py-0.5">
                    <span class="text-[#4E5968] font-medium truncate">${escapeHtml(r.label)} <span class="text-[#8B95A1]">(${r.count})</span></span>
                    <span class="font-bold text-[#191F28] shrink-0">${formatCompactManwon(r.amount)}</span>
                  </div>
                `
                )
                .join('')}
            </div>
          </div>
        `;

        // Render Filter Pills
        const filterOptions = ['전체', '이름 확인 어려움', '취소됨', ...(evt.categories || [])];
        if (!filterOptions.includes(listActiveFilter)) {
          listActiveFilter = '전체';
        }

        const pillsContainer = document.getElementById('listFilterPills');
        pillsContainer.innerHTML = '';

        filterOptions.forEach((opt) => {
          const isActive = listActiveFilter === opt;
          const pill = document.createElement('button');
          pill.type = 'button';
          pill.className = isActive
            ? 'shrink-0 min-h-[38px] px-3.5 rounded-full text-[13px] font-bold bg-[#191F28] text-white transition-colors'
            : 'shrink-0 min-h-[38px] px-3.5 rounded-full text-[13px] font-semibold bg-white border border-[#E8E6E1] text-[#4E5968] hover:border-[#191F28]/40 transition-colors';
          pill.textContent = opt;
          pill.addEventListener('click', () => {
            listActiveFilter = opt;
            renderListTab();
          });
          pillsContainer.appendChild(pill);
        });

        // Filter & Sort Entries
        const q = listSearchQuery.toLowerCase();
        const filtered = allEntries.filter((entry) => {
          if (listActiveFilter === '이름 확인 어려움' && !entry.unknownName) return false;
          if (listActiveFilter === '취소됨' && !entry.cancelled) return false;
          if (
            listActiveFilter !== '전체' &&
            listActiveFilter !== '이름 확인 어려움' &&
            listActiveFilter !== '취소됨' &&
            entry.category !== listActiveFilter
          ) {
            return false;
          }

          if (q) {
            const matchName = (entry.name || '').toLowerCase().includes(q);
            const matchMemo = (entry.memo || '').toLowerCase().includes(q);
            const matchSeq = `#${entry.seq}`.includes(q) || String(entry.seq) === q;
            return matchName || matchMemo || matchSeq;
          }
          return true;
        });

        filtered.sort((a, b) => (listSortDesc ? b.seq - a.seq : a.seq - b.seq));

        document.getElementById('filteredResultCount').textContent = `내역 ${filtered.length}건`;
        document.getElementById('sortOrderLabel').textContent = listSortDesc ? '최신순' : '번호순';

        const listContainer = document.getElementById('entriesListContainer');
        listContainer.innerHTML = '';

        if (filtered.length === 0) {
          listContainer.innerHTML = `
            <div class="card-surface p-8 text-center text-[13.5px] text-[#6B7684]">
              조건에 해당하는 접수 내역이 없습니다.
            </div>
          `;
          return;
        }

        filtered.forEach((entry) => {
          const itemBtn = document.createElement('button');
          itemBtn.type = 'button';
          itemBtn.className = `card-surface w-full p-3.5 text-left hover:border-[#8B263E]/40 active:scale-[0.99] transition-all flex flex-col gap-2 ${
            entry.cancelled ? 'opacity-65 bg-[#FAFAF9]' : ''
          }`;

          const amtText = `${Number(entry.amount).toLocaleString('ko-KR')}원`;

          itemBtn.innerHTML = `
            <div class="w-full flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 min-w-0">
                <span class="px-2 py-0.5 rounded-md bg-[#FDF2F4] border border-[#F3D1D8] text-[12px] font-extrabold text-[#8B263E] shrink-0">
                  #${entry.seq}
                </span>
                <span class="text-[16px] font-bold text-[#191F28] truncate ${entry.cancelled ? 'line-through text-[#6B7684]' : ''}">
                  ${escapeHtml(entry.name)}
                </span>
                ${
                  entry.cancelled
                    ? '<span class="px-1.5 py-0.5 rounded bg-red-50 text-red-600 text-[11px] font-bold shrink-0">취소됨</span>'
                    : ''
