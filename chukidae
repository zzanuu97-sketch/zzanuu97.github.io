        appendHistoryLog(
          evt,
          actionLabel,
          `#${entry.seq} ${entry.name} (${entry.amount.toLocaleString('ko-KR')}원) ${actionLabel} 처리`
        );

        saveEventsToStorage();
        updateReceptionHeaderAndClosedState();
        renderListTab();
        closeModal('editEntryModal');
        showToast(`#${entry.seq} ${actionLabel} 처리되었습니다.`);
      }

      /* ---------------------------------------------------------------------
         TAB 3: '더보기' EXPORT (.xlsx / CSV), JSON BACKUP, CLOSE & HISTORY
         --------------------------------------------------------------------- */
      function sanitizeFileNamePart(str) {
        return String(str || '')
          .trim()
          .replace(/[\\/:*?"<>|]/g, '_');
      }

      function handleExportExcel() {
        const evt = getActiveEvent();
        if (!evt) return;

        const allEntries = evt.entries || [];
        const validEntries = allEntries.filter((e) => !e.cancelled);
        const totalAmount = validEntries.reduce((sum, e) => sum + (Number(e.amount) || 0), 0);
        const totalTickets = validEntries.reduce((sum, e) => sum + (Number(e.tickets) || 0), 0);

        const dateCompact = (evt.date || getTodayDateString()).replace(/-/g, '');
        const baseFilename = `축의대_${sanitizeFileNamePart(evt.groomName)}_${sanitizeFileNamePart(evt.brideName)}_${sanitizeFileNamePart(evt.side)}_${dateCompact}`;

        // Sheet 1 rows: '축의금 접수 내역'
        const sheet1Data = [
          ['순번', '상태', '이름', '금액(원)', '누구 손님', '식권(매)', '메모', '접수시각', '최종수정시각']
        ];

        allEntries.forEach((e) => {
          sheet1Data.push([
            e.seq,
            e.cancelled ? '취소' : '정상',
            e.name,
            Number(e.amount) || 0,
            e.category || '',
            Number(e.tickets) || 0,
            e.memo || '',
            formatDateTimeFull(e.createdAt),
            formatDateTimeFull(e.updatedAt)
          ]);
        });

        sheet1Data.push([]);
        sheet1Data.push(['합계 (정상 접수 기준)', `${validEntries.length}건`, '', totalAmount, '', totalTickets, '', '', '']);

        // Sheet 2 rows: '요약 및 통계'
        const catMap = new Map();
        (evt.categories || []).forEach((c) => catMap.set(c, { count: 0, amount: 0, tickets: 0 }));
        validEntries.forEach((e) => {
          const key = e.category || '미지정';
          if (!catMap.has(key)) catMap.set(key, { count: 0, amount: 0, tickets: 0 });
          const st = catMap.get(key);
          st.count += 1;
          st.amount += Number(e.amount) || 0;
          st.tickets += Number(e.tickets) || 0;
        });

        const sheet2Data = [
          ['예식 기본 정보', ''],
          ['축의대 구분', evt.side],
          ['신랑', evt.groomName],
          ['신부', evt.brideName],
          ['예식 날짜', evt.date],
          ['장소', evt.venue || '-'],
          ['접수 담당자', evt.staff || '-'],
          ['접수 상태', evt.isClosed ? '마감됨' : '진행중'],
          [],
          ['전체 집계 (취소 제외)', ''],
          ['유효 접수 건수', validEntries.length],
          ['취소 건수', allEntries.length - validEntries.length],
          ['총 축의금액(원)', totalAmount],
          ['총 식권 배부(매)', totalTickets],
          [],
          ['누구 손님별 통계', '건수', '금액(원)', '식권(매)']
        ];

        catMap.forEach((st, label) => {
          sheet2Data.push([label, st.count, st.amount, st.tickets]);
        });

        // Try SheetJS (.xlsx) first, with graceful CSV fallback
        if (window.XLSX && window.XLSX.utils) {
          try {
            const wb = window.XLSX.utils.book_new();
            const ws1 = window.XLSX.utils.aoa_to_sheet(sheet1Data);
            const ws2 = window.XLSX.utils.aoa_to_sheet(sheet2Data);

            ws1['!cols'] = [
              { wch: 8 },
              { wch: 8 },
              { wch: 18 },
              { wch: 15 },
              { wch: 14 },
              { wch: 10 },
              { wch: 24 },
              { wch: 20 },
              { wch: 20 }
            ];
            ws2['!cols'] = [{ wch: 22 }, { wch: 16 }, { wch: 16 }, { wch: 12 }];

            window.XLSX.utils.book_append_sheet(wb, ws1, '축의금 접수 내역');
            window.XLSX.utils.book_append_sheet(wb, ws2, '요약 및 통계');

            window.XLSX.writeFile(wb, `${baseFilename}.xlsx`);
            showToast('엑셀(.xlsx) 파일이 저장되었습니다.', 'success');
            return;
          } catch (err) {
            console.warn('SheetJS export failed, falling back to CSV:', err);
          }
        }

        // Graceful UTF-8 BOM CSV Fallback
        const csvLines = sheet1Data
          .map((row) =>
            row
              .map((cell) => `"${String(cell ?? '').replace(/"/g, '""')}"`)
              .join(',')
          )
          .join('\r\n');
        const blob = new Blob(['\uFEFF' + csvLines], { type: 'text/csv;charset=utf-8;' });
        triggerBlobDownload(blob, `${baseFilename}.csv`);
        showToast('엑셀 호환 CSV 파일이 저장되었습니다.', 'success');
      }

      function handleExportJsonBackup() {
        const evt = getActiveEvent();
        if (!evt) return;

        const dateCompact = (evt.date || getTodayDateString()).replace(/-/g, '');
        const filename = `축의대_백업_${sanitizeFileNamePart(evt.groomName)}_${sanitizeFileNamePart(evt.brideName)}_${dateCompact}.json`;

        const payload = {
          app: 'chuguidae',
          version: 1,
          exportedAt: new Date().toISOString(),
          event: evt
        };

        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        triggerBlobDownload(blob, filename);
        showToast('백업 파일(.json)이 저장되었습니다.', 'success');
      }

      function triggerBlobDownload(blob, filename) {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        setTimeout(() => {
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        }, 150);
      }

      function handleImportBackupFile(file) {
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          try {
            const parsed = JSON.parse(e.target.result);
            const importedEvent = parsed && parsed.event ? parsed.event : parsed;

            if (
              !importedEvent ||
              typeof importedEvent !== 'object' ||
              !importedEvent.groomName ||
              !importedEvent.brideName ||
              !Array.isArray(importedEvent.entries)
            ) {
              showToast('올바른 축의대 백업 파일이 아닙니다.', 'error');
              return;
            }

            // Assign fresh ID so existing events on this device are never overwritten unintentionally
            const cloned = {
              ...importedEvent,
              id: generateId('evt'),
              updatedAt: new Date().toISOString()
            };

            appendHistoryLog(cloned, '백업 불러오기', `백업 파일(${file.name})에서 불러옴`);
            events.push(cloned);
            saveEventsToStorage();
            renderHomeScreen();
            showToast(`'${cloned.groomName} ♥ ${cloned.brideName}' 예식을 불러왔습니다.`, 'success');
          } catch (err) {
            console.error('Backup parse error:', err);
            showToast('백업 파일을 읽는 중 오류가 발생했습니다.', 'error');
          }
        };
        reader.readAsText(file, 'utf-8');
      }

      function handleToggleCloseEvent() {
        const evt = getActiveEvent();
        if (!evt) return;

        evt.isClosed = !evt.isClosed;
        evt.updatedAt = new Date().toISOString();

        const actionLabel = evt.isClosed ? '접수 마감' : '접수 다시 열기';
