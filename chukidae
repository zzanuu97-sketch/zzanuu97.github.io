        showToast(evt.isClosed ? '접수가 마감되었습니다.' : '접수가 다시 열렸습니다.');
      }

      function openHistoryModal() {
        const evt = getActiveEvent();
        if (!evt) return;

        const logs = [...(evt.history || [])].reverse();
        document.getElementById('historyCountBadge').textContent = `${logs.length}건`;

        const container = document.getElementById('historyListContainer');
        container.innerHTML = '';

        if (logs.length === 0) {
          container.innerHTML = '<p class="text-center text-[13px] text-[#6B7684] py-8">기록된 변경 이력이 없습니다.</p>';
        } else {
          logs.forEach((log) => {
            const isCancel = log.action.includes('취소') || log.action.includes('마감');
            const badgeStyle = isCancel
              ? 'bg-red-50 text-red-600 border-red-100'
              : 'bg-[#FDF2F4] text-[#8B263E] border-[#F3D1D8]';

