        // Tab 3: '더보기' Actions
        document.getElementById('btnExportExcel').addEventListener('click', handleExportExcel);
        document.getElementById('btnExportJsonBackup').addEventListener('click', handleExportJsonBackup);
        document.getElementById('btnToggleCloseEvent').addEventListener('click', handleToggleCloseEvent);
        document.getElementById('btnEditCurrentEvent').addEventListener('click', () => {
          const evt = getActiveEvent();
          if (evt) openEventForm(evt);
        });
        document.getElementById('btnOpenHistoryModal').addEventListener('click', openHistoryModal);

        // Edit Entry Modal Listeners
        document.getElementById('editUnknownNameCheck').addEventListener('change', (e) => {
          const nameInput = document.getElementById('editNameInput');
          if (e.target.checked) {
            nameInput.value = '이름 확인 어려움';
            nameInput.disabled = true;
          } else {
            nameInput.disabled = false;
            if (nameInput.value === '이름 확인 어려움') nameInput.value = '';
            nameInput.focus();
          }
        });

        document.getElementById('editAmountInput').addEventListener('input', (e) => {
          document.getElementById('editAmountPreview').textContent = formatKoreanWonFull(e.target.value);
        });

        document.getElementById('btnEditTicketMinus').addEventListener('click', () => {
          const input = document.getElementById('editTicketInput');
          input.value = Math.max(0, (Number(input.value) || 0) - 1);
        });
        document.getElementById('btnEditTicketPlus').addEventListener('click', () => {
          const input = document.getElementById('editTicketInput');
          input.value = Math.max(0, (Number(input.value) || 0) + 1);
        });

        document.getElementById('btnCancelEntryToggle').addEventListener('click', handleToggleCancelEntry);
        document.getElementById('btnCloseEditEntry').addEventListener('click', () => closeModal('editEntryModal'));
        document.getElementById('btnSaveEditEntry').addEventListener('click', handleSaveEditEntry);

        // Change History Modal Listener
        document.getElementById('btnCloseHistoryModal').addEventListener('click', () => closeModal('historyModal'));

        // Backdrop click to close secondary modals
        ['guideModal', 'editEntryModal', 'historyModal'].forEach((modalId) => {
          document.getElementById(modalId).addEventListener('click', (e) => {
            if (e.target.id === modalId) {
              closeModal(modalId);
            }
          });
        });
      }

      /* =====================================================================
         10. INITIALIZATION
         ===================================================================== */
      function initApp() {
        initPwaAssets();
        events = loadEventsFromStorage();
        bindEventListeners();
        renderHomeScreen();
        showScreen('homeScreen');

        // Show Welcome Modal on first visit
        try {
          if (!localStorage.getItem(STORAGE_KEYS.WELCOMED)) {
            openModal('welcomeModal');
          }
        } catch (_) {
          openModal('welcomeModal');
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApp);
      } else {
        initApp();
      }
    })();
  </script>
</body>
</html>
