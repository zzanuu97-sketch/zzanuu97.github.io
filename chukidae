      function openEditEntryModal(seq) {
        const evt = getActiveEvent();
        if (!evt) return;
        const entry = (evt.entries || []).find((e) => e.seq === seq);
        if (!entry) return;

        editingEntrySeq = seq;
        editSelectedCategory = entry.category || '';

        document.getElementById('editEntryModalTitle').textContent = `#${entry.seq} 접수 내역 수정`;

        const statusBadge = document.getElementById('editEntryStatusBadge');
        const cancelToggleBtn = document.getElementById('btnCancelEntryToggle');

        if (entry.cancelled) {
          statusBadge.classList.remove('hidden');
          cancelToggleBtn.textContent = '접수 복구';
          cancelToggleBtn.className = 'min-h-[48px] px-3.5 rounded-xl text-[14px] font-bold text-[#059669] bg-[#ECFDF5] hover:bg-[#D1FAE5] transition-colors';
        } else {
          statusBadge.classList.add('hidden');
          cancelToggleBtn.textContent = '접수 취소';
          cancelToggleBtn.className = 'min-h-[48px] px-3.5 rounded-xl text-[14px] font-bold text-red-600 bg-red-50 hover:bg-red-100 transition-colors';
        }

        const unknownCheck = document.getElementById('editUnknownNameCheck');
        const nameInput = document.getElementById('editNameInput');
        unknownCheck.checked = Boolean(entry.unknownName);
        nameInput.disabled = Boolean(entry.unknownName);
        nameInput.value = entry.name || '';

        const amtInput = document.getElementById('editAmountInput');
        amtInput.value = entry.amount || 0;
        document.getElementById('editAmountPreview').textContent = formatKoreanWonFull(entry.amount);

        document.getElementById('editMemoInput').value = entry.memo || '';
        document.getElementById('editTicketInput').value = entry.tickets || 0;

        renderEditCategoryChips();
        openModal('editEntryModal');
      }

      function renderEditCategoryChips() {
        const evt = getActiveEvent();
        const container = document.getElementById('editCategoryChips');
        container.innerHTML = '';
        if (!evt) return;

        const cats = [...(evt.categories || [])];
        if (editSelectedCategory && !cats.includes(editSelectedCategory)) {
          cats.push(editSelectedCategory);
        }

        cats.forEach((cat) => {
          const isSelected = editSelectedCategory === cat;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = isSelected
            ? 'min-h-[38px] px-3 rounded-xl text-[13px] font-bold bg-[#8B263E] text-white border border-[#8B263E]'
            : 'min-h-[38px] px-3 rounded-xl text-[13px] font-semibold bg-[#FAFAF9] text-[#4E5968] border border-[#E8E6E1]';
          btn.textContent = cat;
          btn.addEventListener('click', () => {
            editSelectedCategory = editSelectedCategory === cat ? '' : cat;
            renderEditCategoryChips();
          });
          container.appendChild(btn);
        });
      }

      function handleSaveEditEntry() {
        const evt = getActiveEvent();
        if (!evt || editingEntrySeq === null) return;
        const entry = (evt.entries || []).find((e) => e.seq === editingEntrySeq);
        if (!entry) return;

        const unknownName = document.getElementById('editUnknownNameCheck').checked;
        const rawName = document.getElementById('editNameInput').value.trim();
        const finalName = unknownName ? '이름 확인 어려움' : rawName;

        if (!unknownName && !rawName) {
          showToast('이름을 입력해주세요.', 'error');
          return;
        }

        const newAmount = Math.max(0, Math.round(Number(document.getElementById('editAmountInput').value) || 0));
        if (newAmount <= 0) {
          showToast('금액은 0원보다 커야 합니다.', 'error');
          return;
        }

        const newMemo = document.getElementById('editMemoInput').value.trim();
        const newTickets = Math.max(0, Math.round(Number(document.getElementById('editTicketInput').value) || 0));

        // Build detailed field diff log
        const diffs = [];
        if (entry.name !== finalName) diffs.push(`이름: '${entry.name}' → '${finalName}'`);
        if (entry.amount !== newAmount) {
          diffs.push(`금액: ${entry.amount.toLocaleString('ko-KR')}원 → ${newAmount.toLocaleString('ko-KR')}원`);
        }
        if ((entry.category || '') !== editSelectedCategory) {
          diffs.push(`구분: '${entry.category || '없음'}' → '${editSelectedCategory || '없음'}'`);
        }
        if ((entry.memo || '') !== newMemo) {
          diffs.push(`메모: '${entry.memo || '없음'}' → '${newMemo || '없음'}'`);
        }
        if ((entry.tickets || 0) !== newTickets) {
          diffs.push(`식권: ${entry.tickets || 0}매 → ${newTickets}매`);
        }

        entry.name = finalName;
        entry.unknownName = unknownName;
        entry.amount = newAmount;
        entry.category = editSelectedCategory;
        entry.memo = newMemo;
        entry.tickets = newTickets;
        entry.updatedAt = new Date().toISOString();
        evt.updatedAt = entry.updatedAt;

        appendHistoryLog(
          evt,
          '내역 수정',
          diffs.length > 0 ? `#${entry.seq} ${diffs.join(', ')}` : `#${entry.seq} ${finalName} 저장 (변경 없음)`
        );

        saveEventsToStorage();
        updateReceptionHeaderAndClosedState();
        renderListTab();
        closeModal('editEntryModal');
        showToast(`#${entry.seq} 내역이 수정되었습니다.`, 'success');
      }

      function handleToggleCancelEntry() {
        const evt = getActiveEvent();
        if (!evt || editingEntrySeq === null) return;
        const entry = (evt.entries || []).find((e) => e.seq === editingEntrySeq);
        if (!entry) return;

        entry.cancelled = !entry.cancelled;
        entry.updatedAt = new Date().toISOString();
        evt.updatedAt = entry.updatedAt;

